# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# OS / IDE
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~

# secrets and local certificates
*.pem
*.key
*.p12
*.pfx

# logs and temporary files
*.log
logs/
*.tmp
*.temp
.cache/
.tmp/
tmp/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local Postman workspace state and generated artifacts
.postman/
postman/

# env files (can opt-in for committing if needed)
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Uploads
public/uploads/

# AI agent config / session files (never commit)
.claude/
.kimi/
.agents/
.ai/

# local tooling
bunfig.toml
.yarnrc
.yarnrc.yml
.npmrc
pnpm-lock.yaml
yarn.lock

# test artifacts
socket-test.cjs
workspace.zip

# expo / react native (mobile/)
mobile/node_modules/
mobile/.expo/
mobile/dist/
mobile/web-build/
mobile/*.tsbuildinfo
mobile/android/
mobile/ios/
mobile/.env.local
